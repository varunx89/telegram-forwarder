# ====================================================================
# TELEGRAM API CREDENTIALS (Required)
# Obtain these by logging into https://my.telegram.org -> API development tools
# ====================================================================
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash_here

# ====================================================================
# TELETHON SESSION PERSISTENCE (Required for Headless Operation)
# Generate your StringSession locally by running:
#   python generate_session.py
# Follow the interactive prompts (phone, SMS code, 2FA password).
# Paste the resulting string below.
# ====================================================================
TG_SESSION_STRING=1BVtsOIWbu0...paste_your_telethon_string_session_here...

# ====================================================================
# FORWARDING RULES
# ====================================================================
# Source group title to monitor (case-insensitive)
TARGET_GROUP_NAME=Premium Membership Group

# Optional exact numeric ID of the source chat (e.g. -1001234567890).
# When set, the service strictly matches chat ID and ignores group title,
# preventing unauthorized title spoofing.
# TARGET_GROUP_ID=-1001234567890

# Destination recipient: Can be a username (@recipient), numeric user ID (123456789),
# channel/group ID (-1001234567890), or 'me' (Saved Messages).
FORWARD_TO_USERNAME=@your_recipient_username_or_id

# If the source group has "Restrict saving content" (noforwards) enabled,
# standard Telegram forwarding fails. Setting this to true automatically
# falls back to direct copying of message text, formatted entities, and media.
FALLBACK_COPY_ON_RESTRICTED=true

# ====================================================================
# NETWORK & IPV6 CONFIGURATION
# ====================================================================
# Enable IPv6 for Telegram MTProto and outbound network connections.
# Essential for IPv6-only environments (VMs without outbound IPv4, IPv6 containers).
# Default: true
USE_IPV6=true

# Optional override specifically for Telegram MTProto:
# TG_USE_IPV6=true

# ====================================================================
# SERVER NETWORK BINDING & HEALTH CHECKS
# Minimal FastAPI server for cloud liveness and readiness probes (/health, /live)
# ====================================================================
# Bind host: '::' binds to all IPv6 and IPv4 interfaces (dual-stack / IPv6-only).
# Use '0.0.0.0' only if your system has IPv6 completely disabled.
HOST=::
PORT=10000
LOG_LEVEL=INFO
