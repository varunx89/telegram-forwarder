# ====================================================================
# TELEGRAM API CREDENTIALS (Required)
# Obtain these by logging into https://my.telegram.org -> API development tools
# ====================================================================
TG_API_ID=12345678
TG_API_HASH=your_telegram_api_hash_here

# Optional default phone number for login wizard (e.g. +1234567890)
TG_PHONE=

# ====================================================================
# TELETHON SESSION PERSISTENCE
# When deploying on Render, you can log in once via the Web UI in your browser,
# copy the generated StringSession, and paste it here in TG_SESSION_STRING.
# This guarantees 100% permanent persistence without requiring a paid Render Disk.
# ====================================================================
TG_SESSION_STRING=
TG_SESSION_NAME=data/telegram_session

# ====================================================================
# FORWARDING RULES
# Matches messages strictly from TARGET_GROUP_NAME and forwards them to FORWARD_TO_USERNAME
# ====================================================================
TARGET_GROUP_NAME=Premium Membership Group
# TARGET_GROUP_ID=-1001234567890
FORWARD_TO_USERNAME=@V_C_0_3

# If the source group has "Restrict saving content" (noforwards) enabled,
# standard forward fails. Setting this to true will automatically copy text & media.
FALLBACK_COPY_ON_RESTRICTED=true

# ====================================================================
# WEB DASHBOARD & BROWSER LOGIN SECURITY (Crucial for Cloud Deployment)
# ====================================================================
# Change this to a strong, random password. Anyone visiting your Render URL
# must enter this password to access the login wizard and live logs.
ADMIN_PASSWORD=change_this_to_a_secure_random_admin_password

# Random secret key for signing admin authentication session cookies
SECRET_KEY=generate_a_random_32_byte_hex_secret_key_here
COOKIE_NAME=tg_fwd_session

# ====================================================================
# SERVER NETWORK BINDING
# ====================================================================
HOST=0.0.0.0
PORT=10000
LOG_LEVEL=INFO
MAX_LOG_ENTRIES=200
